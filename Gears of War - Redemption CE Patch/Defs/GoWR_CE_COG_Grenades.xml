<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef Class="CombatExtended.AmmoDef" ParentName="BaseGrenadeEquipment">
        <defName>Weapon_GOW_COGFrag</defName>
        <label>COG bolo-frag grenade</label>

        <description>A fragmentation explosive attached to a weighted chain. By swinging the bolo before release, a trained user can throw it farther than a conventional hand grenade. Standard issue among COG forces, the Bolo-Frag produces a powerful blast and a lethal spray of fragments.</description>

        <equipmentType>Primary</equipmentType>
        <soundInteract>Interact_Grenade</soundInteract>
        <techLevel>Industrial</techLevel>

        <recipeMaker>
            <researchPrerequisite>GOW_Cogmillitary</researchPrerequisite>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>900</displayPriority>
        </recipeMaker>

        <graphicData>
            <texPath>Things/Ammo/COGFrag</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
        </graphicData>

        <uiIconScale>1.3</uiIconScale>

        <statBases>
            <Mass>1.5</Mass>
            <Bulk>1.25</Bulk>
            <WorkToMake>20000</WorkToMake>
            <SightsEfficiency>1.0</SightsEfficiency>
            <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
        </statBases>

        <costList>
            <Steel>40</Steel>
            <Chemfuel>85</Chemfuel>
        </costList>

        <stackLimit>25</stackLimit>
        <resourceReadoutPriority>First</resourceReadoutPriority>
        <smeltable>false</smeltable>

        <weaponTags>
            <li>CE_AI_Grenade</li>
            <li>CE_AI_AOE</li>
            <li>CE_OneHandedWeapon</li>
        </weaponTags>

        <thingCategories>
            <li>Grenades</li>
        </thingCategories>

        <comps>
            <li Class="CombatExtended.CompProperties_ExplosiveCE">
                <damageAmountBase>65</damageAmountBase>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <explosiveRadius>1.9</explosiveRadius>
            </li>
        </comps>

        <verbs>
            <li Class="CombatExtended.VerbPropertiesCE">
                <label>throw COG bolo-frag</label>
                <verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
                <hasStandardCommand>true</hasStandardCommand>

                <range>18.0</range>
                <minRange>5.0</minRange>
                <minRangeInCover>3</minRangeInCover>

                <warmupTime>1.15</warmupTime>
                <noiseRadius>4</noiseRadius>

                <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
                <soundCast>Shot_GOW_Bolo</soundCast>

                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>

                <defaultProjectile>Proj_GOW_COGGrenadeFrag</defaultProjectile>

                <onlyManualCast>false</onlyManualCast>
                <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
                <ai_AvoidFriendlyFireRadius>8</ai_AvoidFriendlyFireRadius>
            </li>
        </verbs>

        <detonateProjectile>Proj_GOW_COGGrenadeFrag</detonateProjectile>
    </ThingDef>

    <ThingDef ParentName="BaseGrenadeProjectile">
        <defName>Proj_GOW_COGGrenadeFrag</defName>
        <label>COG bolo-frag</label>

        <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>

        <graphicData>
            <texPath>Things/Ammo/COGFrag_Projectile/COGGrenade_Thrown</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>

        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <explosionRadius>1.9</explosionRadius>
            <damageDef>Bomb</damageDef>
            <damageAmountBase>65</damageAmountBase>
            <explosionDelay>75</explosionDelay>

            <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>

            <dropsCasings>true</dropsCasings>
            <casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
            <casingFilthDefname>Filth_GrenadeAmmoCasings</casingFilthDefname>

            <speed>12</speed>
            <screenShakeFactor>0.5</screenShakeFactor>

            <suppressionFactor>3.0</suppressionFactor>
            <dangerFactor>2.0</dangerFactor>
            <airborneSuppressionFactor>0.25</airborneSuppressionFactor>

            <ballisticCoefficient>2.0~2.0</ballisticCoefficient>
            <mass>1500~1500</mass>
            <diameter>100~100</diameter>
        </projectile>

        <comps>
            <li Class="CombatExtended.CompProperties_Fragments">
                <fragments>
                    <Fragment_Small>60</Fragment_Small>
                </fragments>
            </li>
        </comps>
    </ThingDef>

</Defs>