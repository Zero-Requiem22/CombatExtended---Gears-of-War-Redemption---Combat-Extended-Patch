<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RecipeDef ParentName="GrenadeRecipeBase">
        <defName>Make_GOW_LocustBoloFragGrenades</defName>
        <label>make Locust bolo-frags x5</label>
        <description>Craft five Locust Bolo-Frag grenades.</description>
        <jobString>Making Locust Bolo-Frags.</jobString>

        <researchPrerequisite>GOW_Locustdrones</researchPrerequisite>
        <workAmount>7500</workAmount>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>20</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>FSX</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>Steel</li>
                <li>FSX</li>
                <li>ComponentIndustrial</li>
            </thingDefs>
        </fixedIngredientFilter>

        <products>
            <Weapon_GOW_LocustFrag>5</Weapon_GOW_LocustFrag>
        </products>
    </RecipeDef>

