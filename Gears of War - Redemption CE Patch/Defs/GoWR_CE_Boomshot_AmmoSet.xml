<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ====================================================== -->
    <!-- Boomshot 50 mm cluster grenades                       -->
    <!-- ====================================================== -->

    <ThingCategoryDef>
        <defName>AmmoGOW_Boomshot50mm</defName>
        <label>Boomshot 50 mm grenades</label>
        <parent>AmmoGrenades</parent>
        <iconPath>UI/Icons/ThingCategories/CaliberGrenade</iconPath>
    </ThingCategoryDef>

    <CombatExtended.AmmoSetDef>
        <defName>AmmoSet_GOW_Boomshot50mm</defName>
        <label>Boomshot 50 mm cluster grenades</label>

        <ammoTypes>
            <Ammo_GOW_Boomshot50mm_HE>Bullet_GOW_Boomshot50mm_HE</Ammo_GOW_Boomshot50mm_HE>
            <Ammo_GOW_Boomshot50mm_EMP>Bullet_GOW_Boomshot50mm_EMP</Ammo_GOW_Boomshot50mm_EMP>
            <Ammo_GOW_Boomshot50mm_Smoke>Bullet_GOW_Boomshot50mm_Smoke</Ammo_GOW_Boomshot50mm_Smoke>
        </ammoTypes>

        <similarTo>AmmoSet_LauncherGrenade</similarTo>
    </CombatExtended.AmmoSetDef>

    <!-- ====================================================== -->
    <!-- Ammo items                                             -->
    <!-- ====================================================== -->

    <ThingDef Class="CombatExtended.AmmoDef" Name="GOW_Boomshot50mmAmmoBase" ParentName="MediumAmmoBase" Abstract="True">
        <description>Heavy 50 mm cluster grenades for the Locust Boomshot. The high-explosive round produces a large primary blast and disperses lethal fragments.</description>
        <statBases>
            <Mass>0.55</Mass>
            <Bulk>2.50</Bulk>
        </statBases>
        <tradeTags>
            <li>CE_AutoEnableTrade</li>
            <li>CE_AutoEnableCrafting_TableMachining</li>
        </tradeTags>
        <thingCategories>
            <li>AmmoGOW_Boomshot50mm</li>
        </thingCategories>
        <stackLimit>30</stackLimit>
        <cookOffFlashScale>30</cookOffFlashScale>
    </ThingDef>

    <ThingDef Class="CombatExtended.AmmoDef" ParentName="GOW_Boomshot50mmAmmoBase">

        <defName>Ammo_GOW_Boomshot50mm_HE</defName>
        <label>Boomshot 50 mm cluster grenade (HE)</label>
        <graphicData>
            <texPath>Things/Ammo/Boomshot/HE</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <ammoClass>GrenadeHE</ammoClass>
        <detonateProjectile>Bullet_GOW_Boomshot50mm_HE</detonateProjectile>
    </ThingDef>

    <ThingDef Class="CombatExtended.AmmoDef" ParentName="GOW_Boomshot50mmAmmoBase">

        <defName>Ammo_GOW_Boomshot50mm_EMP</defName>
        <label>Boomshot 50 mm cluster grenade (EMP)</label>
        <graphicData>
            <texPath>Things/Ammo/Boomshot/EMP</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <ammoClass>GrenadeEMP</ammoClass>
        <generateAllowChance>0.35</generateAllowChance>
        <detonateProjectile>Bullet_GOW_Boomshot50mm_EMP</detonateProjectile>
    </ThingDef>

    <ThingDef Class="CombatExtended.AmmoDef" ParentName="GOW_Boomshot50mmAmmoBase">

        <defName>Ammo_GOW_Boomshot50mm_Smoke</defName>
        <label>Boomshot 50 mm cluster grenade (smoke)</label>
        <graphicData>
            <texPath>Things/Ammo/Boomshot/SMK</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <ammoClass>Smoke</ammoClass>
        <generateAllowChance>0.10</generateAllowChance>
        <detonateProjectile>Bullet_GOW_Boomshot50mm_Smoke</detonateProjectile>
    </ThingDef>

    <!-- ====================================================== -->
    <!-- Projectile base                                        -->
    <!-- ====================================================== -->

    <ThingDef Name="BaseGOW_Boomshot50mmProjectile" ParentName="BaseExplosiveBullet" Abstract="True">
        <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>

        <graphicData>
            <texPath>Things/Projectile/LauncherShot</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.65,0.65)</drawSize>
        </graphicData>

        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <speed>30</speed>
            <explosionDelay>20</explosionDelay>
            <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
            <suppressionFactor>4.0</suppressionFactor>
            <dangerFactor>3.0</dangerFactor>
            <airborneSuppressionFactor>0.25</airborneSuppressionFactor>
            <ballisticCoefficient>8.0~8.0</ballisticCoefficient>
            <mass>550~550</mass>
            <diameter>50~50</diameter>
        </projectile>
    </ThingDef>

    <!-- ====================================================== -->
    <!-- HE cluster projectile                                  -->
    <!-- ====================================================== -->

    <ThingDef ParentName="BaseGOW_Boomshot50mmProjectile">
        <defName>Bullet_GOW_Boomshot50mm_HE</defName>
        <label>Boomshot 50 mm cluster grenade (HE)</label>

        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <damageDef>Bomb</damageDef>
            <damageAmountBase>45</damageAmountBase>
            <explosionRadius>2.6</explosionRadius>
        </projectile>

        <comps>
            <li Class="CombatExtended.CompProperties_Fragments">
                <fragments>
                    <Fragment_Small>60</Fragment_Small>
                </fragments>
            </li>
        </comps>
    </ThingDef>

    <!-- ====================================================== -->
    <!-- EMP projectile                                         -->
    <!-- ====================================================== -->

    <ThingDef ParentName="BaseGOW_Boomshot50mmProjectile">
        <defName>Bullet_GOW_Boomshot50mm_EMP</defName>
        <label>Boomshot 50 mm grenade (EMP)</label>

        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <damageDef>EMP</damageDef>
            <damageAmountBase>35</damageAmountBase>
            <explosionRadius>3.0</explosionRadius>
        </projectile>
    </ThingDef>

    <!-- ====================================================== -->
    <!-- Smoke projectile                                       -->
    <!-- ====================================================== -->

    <ThingDef ParentName="BaseGOW_Boomshot50mmProjectile">
        <defName>Bullet_GOW_Boomshot50mm_Smoke</defName>
        <label>Boomshot 50 mm grenade (smoke)</label>

        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <damageDef>Smoke</damageDef>
            <explosionRadius>3.0</explosionRadius>
            <suppressionFactor>0.0</suppressionFactor>
            <dangerFactor>0.0</dangerFactor>

            <postExplosionGasType>BlindSmoke</postExplosionGasType>
            <preExplosionSpawnChance>1</preExplosionSpawnChance>
        </projectile>
    </ThingDef>

    <!-- ====================================================== -->
    <!-- Boomshot 50 mm Cluster Grenade Recipes                -->
    <!-- ====================================================== -->

    <!-- HE Rounds -->
    <RecipeDef ParentName="LauncherAmmoRecipeBase">
        <defName>MakeAmmo_GOW_Boomshot50mm_HE</defName>
        <label>make Boomshot 50 mm cluster grenades (HE) x10</label>
        <description>Craft 10 high-explosive 50 mm cluster grenades for the Locust Boomshot.</description>
        <jobString>Making Boomshot HE cluster grenades.</jobString>

        <researchPrerequisites>
            <li>GOW_Locustboomers</li>
            <li>CE_Launchers</li>
        </researchPrerequisites>

        <workAmount>6500</workAmount>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>18</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>FSX</li>
                    </thingDefs>
                </filter>
                <count>8</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>Steel</li>
                <li>FSX</li>
                <li>ComponentIndustrial</li>
            </thingDefs>
        </fixedIngredientFilter>

        <products>
            <Ammo_GOW_Boomshot50mm_HE>10</Ammo_GOW_Boomshot50mm_HE>
        </products>
    </RecipeDef>

    <!-- EMP Rounds -->
    <RecipeDef ParentName="LauncherAmmoRecipeBase">
        <defName>MakeAmmo_GOW_Boomshot50mm_EMP</defName>
        <label>make Boomshot 50 mm cluster grenades (EMP) x10</label>
        <description>Craft 10 EMP 50 mm grenades for the Locust Boomshot.</description>
        <jobString>Making Boomshot EMP grenades.</jobString>

        <researchPrerequisites>
            <li>GOW_Locustboomers</li>
            <li>CE_Launchers</li>
            <li>MicroelectronicsBasics</li>
        </researchPrerequisites>

        <workAmount>8500</workAmount>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>18</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>4</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>Gold</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>Steel</li>
                <li>ComponentIndustrial</li>
                <li>Gold</li>
            </thingDefs>
        </fixedIngredientFilter>

        <products>
            <Ammo_GOW_Boomshot50mm_EMP>10</Ammo_GOW_Boomshot50mm_EMP>
        </products>
    </RecipeDef>

    <!-- Smoke Rounds -->
    <RecipeDef ParentName="LauncherAmmoRecipeBase">
        <defName>MakeAmmo_GOW_Boomshot50mm_Smoke</defName>
        <label>make Boomshot 50 mm cluster grenades (smoke) x10</label>
        <description>Craft 10 smoke 50 mm grenades for the Locust Boomshot.</description>
        <jobString>Making Boomshot smoke grenades.</jobString>

        <researchPrerequisites>
            <li>GOW_Locustboomers</li>
            <li>CE_Launchers</li>
        </researchPrerequisites>

        <workAmount>5000</workAmount>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>15</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>Prometheum</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>

        <fixedIngredientFilter>
            <thingDefs>
                <li>Steel</li>
                <li>Prometheum</li>
                <li>ComponentIndustrial</li>
            </thingDefs>
        </fixedIngredientFilter>

        <products>
            <Ammo_GOW_Boomshot50mm_Smoke>10</Ammo_GOW_Boomshot50mm_Smoke>
        </products>
    </RecipeDef>

</Defs>