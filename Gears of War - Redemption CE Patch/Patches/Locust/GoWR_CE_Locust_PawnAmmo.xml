    <!-- ====================================================== -->
    <!-- Locust Theron Guard                                    -->
    <!-- May spawn with Hammerburst Mk II, Torque Bow, or       -->
    <!-- Gnasher. Carry a modest compatible reserve for all.    -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="GOW_Locust_Fighter_Theron"]</xpath>
        <value>
            <inventoryOptions>
                <skipChance>0</skipChance>

                <subOptionsTakeAll>

                    <!-- Hammerburst Mk II: 20-round magazine. -->
                    <li>
                        <thingDef>Ammo_762x39mmSoviet_FMJ</thingDef>
                        <countRange>40</countRange>
                    </li>

                    <li>
                        <thingDef>Ammo_762x39mmSoviet_AP</thingDef>
                        <countRange>20</countRange>
                    </li>

                    <!-- Torque Bow: one bolt loaded at a time. -->
                    <li>
                        <thingDef>Ammo_GOW_TorqueBolt</thingDef>
                        <countRange>3</countRange>
                    </li>

                    <!-- Gnasher: 8-shell magazine. -->
                    <li>
                        <thingDef>Ammo_10Gauge_Buck</thingDef>
                        <countRange>16</countRange>
                    </li>

                </subOptionsTakeAll>
            </inventoryOptions>
        </value>
    </Operation>

