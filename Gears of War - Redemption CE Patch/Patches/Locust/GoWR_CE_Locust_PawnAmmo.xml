                <skipChance>0</skipChance>

                <subOptionsChooseOne>
                    <li>
                        <choiceChance>70</choiceChance>
                        <thingDef>Ammo_762x39mmSoviet_FMJ</thingDef>
                        <countRange>117~156</countRange>
