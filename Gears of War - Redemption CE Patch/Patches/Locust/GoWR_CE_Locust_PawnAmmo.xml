<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- ====================================================== -->
    <!-- Standard Locust Drone                                  -->
    <!-- Hammerburst Mk I only                                  -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/PawnKindDef[defName="GOW_Locust_Fighter_Drone"]/weaponTags</xpath>
        <value>
            <weaponTags>
                <li>LocustHammerburst</li>
                <li>Locustsidearm</li>
            </weaponTags>
        </value>
    </Operation>

    <!-- Hammerburst costs at least 625; prevent weaponless spawns. -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/PawnKindDef[defName="GOW_Locust_Fighter_Drone"]/weaponMoney</xpath>
        <value>
            <weaponMoney>650~850</weaponMoney>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PawnKindDef[defName="GOW_Locust_Fighter_Drone"]</xpath>
        <value>
            <inventoryOptions>
                <skipChance>0</skipChance>

                <subOptionsChooseOne>
                    <!-- Common standard rifle ammunition -->
                    <li>
                        <choiceChance>70</choiceChance>
                        <thingDef>Ammo_762x39mmSoviet_FMJ</thingDef>
                        <countRange>117~156</countRange>
                    </li>

                    <!-- Less-common armor-piercing ammunition -->
                    <li>
                        <choiceChance>20</choiceChance>
                        <thingDef>Ammo_762x39mmSoviet_AP</thingDef>
                        <countRange>78~117</countRange>
                    </li>

                    <!-- Anti-unarmored / biological-target ammunition -->
                    <li>
                        <choiceChance>10</choiceChance>
                        <thingDef>Ammo_762x39mmSoviet_HP</thingDef>
                        <countRange>117~156</countRange>
                    </li>
                </subOptionsChooseOne>
            </inventoryOptions>
        </value>
    </Operation>

