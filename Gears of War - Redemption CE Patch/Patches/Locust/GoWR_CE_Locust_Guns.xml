<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- ====================================================== -->
    <!-- Locust Hammerburst Mk I                               -->
    <!-- ====================================================== -->

    <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>Gun_GOW_Hammerburst</defName>
        <statBases>
            <WorkToMake>43750</WorkToMake>
            <Mass>5.0</Mass>
            <Bulk>5.5</Bulk>
            <SwayFactor>1.05</SwayFactor>
            <ShotSpread>0.090</ShotSpread>
            <SightsEfficiency>0.82</SightsEfficiency>
            <RangedWeapon_Cooldown>0.55</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>95</Steel>
            <ComponentIndustrial>9</ComponentIndustrial>
        </costList>
        <Properties>
            <verbClass>CombatExtended.Verb_ShootCE</verbClass>
            <hasStandardCommand>true</hasStandardCommand>
            <defaultProjectile>Bullet_762x39mmSoviet_FMJ</defaultProjectile>
            <burstShotCount>6</burstShotCount>
            <ticksBetweenBurstShots>3</ticksBetweenBurstShots>
            <warmupTime>1.10</warmupTime>
            <range>35</range>
            <soundCast>Shot_GOW_MK2Hammerburst</soundCast>
            <soundCastTail>GunTail_Medium</soundCastTail>
            <muzzleFlashScale>9</muzzleFlashScale>
            <recoilAmount>1.05</recoilAmount>
        </Properties>
        <AmmoUser>
            <magazineSize>78</magazineSize>
            <reloadTime>4.8</reloadTime>
            <ammoSet>AmmoSet_762x39mmSoviet</ammoSet>
        </AmmoUser>
        <FireModes>
            <aiUseBurstMode>true</aiUseBurstMode>
            <aiAimMode>AimedShot</aiAimMode>
            <aimedBurstShotCount>3</aimedBurstShotCount>
        </FireModes>
        <weaponTags>
            <li>CE_AI_AssaultWeapon</li>
            <li>CE_AI_Rifle</li>
        </weaponTags>
    </Operation>

    <!-- Conventional rifle melee only; no bayonet. -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Gun_GOW_Hammerburst"]/tools</xpath>
        <value>
            <tools>
                <li Class="CombatExtended.ToolCE">
                    <label>stock</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>10</power>
                    <cooldownTime>2.0</cooldownTime>
                    <armorPenetrationBlunt>1.0</armorPenetrationBlunt>
                </li>

                <li Class="CombatExtended.ToolCE">
                    <label>barrel</label>
                    <capacities>
                        <li>Blunt</li>
                        <li>Poke</li>
                    </capacities>
                    <power>10</power>
                    <cooldownTime>2.0</cooldownTime>
                    <armorPenetrationBlunt>0.9</armorPenetrationBlunt>
                    <armorPenetrationSharp>0.4</armorPenetrationSharp>
                </li>
            </tools>
        </value>
    </Operation>

