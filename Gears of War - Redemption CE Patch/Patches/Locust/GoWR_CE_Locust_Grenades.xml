<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- ====================================================== -->
    <!-- Locust Bolo-Frag Grenade                              -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/label</xpath>
        <value>
            <label>Locust bolo-frag grenade</label>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/description</xpath>
        <value>
            <description>A fragmentation explosive attached to a weighted chain. By swinging the bolo before release, a trained user can throw it farther than a conventional hand grenade. Used by the Locust Horde, the Bolo-Frag produces a powerful blast and a lethal spray of fragments.</description>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/smeltable</xpath>
        <value>
            <smeltable>false</smeltable>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]</xpath>
        <value>
            <thingClass>CombatExtended.AmmoThing</thingClass>
            <stackLimit>25</stackLimit>
            <resourceReadoutPriority>First</resourceReadoutPriority>
        </value>
    </Operation>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]</xpath>
        <attribute>Class</attribute>
        <value>CombatExtended.AmmoDef</value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/statBases</xpath>
        <value>
            <Bulk>1.25</Bulk>
            <SightsEfficiency>1.0</SightsEfficiency>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/statBases/Mass</xpath>
        <value>
            <Mass>1.5</Mass>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/statBases/RangedWeapon_Cooldown</xpath>
        <value>
            <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/comps</xpath>
        <value>
            <comps>
                <li Class="CombatExtended.CompProperties_ExplosiveCE">
                    <damageAmountBase>65</damageAmountBase>
                    <explosiveDamageType>Bomb</explosiveDamageType>
                    <explosiveRadius>1.9</explosiveRadius>
                </li>
            </comps>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Weapon_GOW_LocustFrag"]/graphicData</xpath>
        <value>
            <graphicData>
                <texPath>Things/Ammo/LocustFrag</texPath>
                <graphicClass>Graphic_StackCount</graphicClass>
                <onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
            </graphicData>
        </value>
    </Operation>

    <!-- ====================================================== -->
    <!-- Locust Bolo-Frag projectile                            -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Proj_GOW_LocustGrenadeFrag"]/thingClass</xpath>
        <value>
            <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Proj_GOW_LocustGrenadeFrag"]/projectile</xpath>
        <value>
            <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <explosionRadius>1.9</explosionRadius>
                <damageDef>Bomb</damageDef>
                <damageAmountBase>65</damageAmountBase>
                <explosionDelay>75</explosionDelay>

                <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>

                <dropsCasings>true</dropsCasings>
                <casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
                <casingFilthDefname>Filth_GrenadeAmmoCasings</casingFilthDefname>

                <speed>12</speed>
                <screenShakeFactor>0.5</screenShakeFactor>

                <suppressionFactor>3.0</suppressionFactor>
                <dangerFactor>2.0</dangerFactor>
                <airborneSuppressionFactor>0.25</airborneSuppressionFactor>

                <ballisticCoefficient>2.0~2.0</ballisticCoefficient>
                <mass>1500~1500</mass>
                <diameter>100~100</diameter>
            </projectile>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Proj_GOW_LocustGrenadeFrag"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="Proj_GOW_LocustGrenadeFrag"]</xpath>
            <value>
                <comps />
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Proj_GOW_LocustGrenadeFrag"]/comps</xpath>
        <value>
            <li Class="CombatExtended.CompProperties_Fragments">
                <fragments>
                    <Fragment_Small>60</Fragment_Small>
                </fragments>
            </li>
        </value>
    </Operation>

    <!-- ====================================================== -->
    <!-- Locust Bolo-Frag throw verb                            -->
    <!-- ====================================================== -->

    <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>Weapon_GOW_LocustFrag</defName>

        <statBases>
            <Mass>1.5</Mass>
            <Bulk>1.25</Bulk>
            <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
            <SightsEfficiency>1.0</SightsEfficiency>
        </statBases>

        <Properties>
            <label>throw Locust bolo-frag</label>
            <verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
            <hasStandardCommand>true</hasStandardCommand>

            <range>18.0</range>
            <minRange>5.0</minRange>

            <warmupTime>1.15</warmupTime>
            <noiseRadius>4</noiseRadius>

            <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
            <soundCast>Shot_GOW_Bolo</soundCast>

            <targetParams>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>

            <defaultProjectile>Proj_GOW_LocustGrenadeFrag</defaultProjectile>

            <onlyManualCast>false</onlyManualCast>
            <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
            <ai_AvoidFriendlyFireRadius>8</ai_AvoidFriendlyFireRadius>
            <minRangeInCover>3</minRangeInCover>
        </Properties>

        <weaponTags>
            <li>CE_AI_Grenade</li>
            <li>CE_AI_AOE</li>
            <li>CE_OneHandedWeapon</li>
        </weaponTags>
    </Operation>

</Patch>