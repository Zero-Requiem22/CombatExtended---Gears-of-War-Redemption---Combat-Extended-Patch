<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- ====================================================== -->
    <!-- Locust Drone Caste                                     -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustDrone"]/statOffsets/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustDrone"]/statOffsets/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>5.0</ArmorRating_Blunt>
        </value>
    </Operation>

    <!-- ====================================================== -->
    <!-- Locust Boomer Caste                                    -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustBoomer"]/statOffsets/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>5.0</ArmorRating_Sharp>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustBoomer"]/statOffsets/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>12.0</ArmorRating_Blunt>
        </value>
    </Operation>

    <!-- ====================================================== -->
    <!-- Locust Kantus Caste                                    -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustKantus"]/statOffsets/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>2.5</ArmorRating_Sharp>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustKantus"]/statOffsets/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>7.0</ArmorRating_Blunt>
        </value>
    </Operation>

    <!-- ====================================================== -->
    <!-- Locust Berserker Caste                                 -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustBerserker"]/statOffsets/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>17.0</ArmorRating_Sharp>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustBerserker"]/statOffsets/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>35.0</ArmorRating_Blunt>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GeneDef[defName="GOW_LocustBerserker"]/statFactors/IncomingDamageFactor</xpath>
        <value>
            <IncomingDamageFactor>0.75</IncomingDamageFactor>
        </value>
    </Operation>

    <!-- ====================================================== -->
    <!-- Berserker melee                                        -->
    <!-- ====================================================== -->

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GOW_Berserker"]/tools</xpath>
        <value>
            <tools>

                <li Class="CombatExtended.ToolCE">
                    <label>left giant fist</label>
                    <labelNoLocation>fist</labelNoLocation>

                    <capacities>
                        <li>Blunt</li>
                        <li>Scratch</li>
                        <li>Demolish</li>
                    </capacities>

                    <power>25</power>
                    <cooldownTime>2</cooldownTime>
                    <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>

                    <armorPenetration>7.0</armorPenetration>

                    <surpriseAttack>
                        <extraMeleeDamages>
                            <li>
                                <def>Stun</def>
                                <amount>25</amount>
                            </li>
                        </extraMeleeDamages>
                    </surpriseAttack>
                </li>

                <li Class="CombatExtended.ToolCE">
                    <label>right giant fist</label>
                    <labelNoLocation>fist</labelNoLocation>

                    <capacities>
                        <li>Blunt</li>
                        <li>Scratch</li>
                        <li>Demolish</li>
                    </capacities>

                    <power>25</power>
                    <cooldownTime>2</cooldownTime>
                    <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>

                    <armorPenetration>7.0</armorPenetration>

                    <surpriseAttack>
                        <extraMeleeDamages>
                            <li>
                                <def>Stun</def>
                                <amount>25</amount>
                            </li>
                        </extraMeleeDamages>
                    </surpriseAttack>
                </li>

            </tools>
        </value>
    </Operation>

</Patch>