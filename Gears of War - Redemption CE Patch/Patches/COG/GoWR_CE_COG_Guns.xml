<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- ====================================================== -->
    <!-- COG MK1 / Retro Lancer                                -->
    <!-- ====================================================== -->

    <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>Gun_GOW_RetroLancer</defName>
        <statBases>
            <WorkToMake>41250</WorkToMake>
            <Mass>4.8</Mass>
            <Bulk>5.2</Bulk>
            <SwayFactor>1.25</SwayFactor>
            <ShotSpread>0.11</ShotSpread>
            <SightsEfficiency>0.75</SightsEfficiency>
            <RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>75</Steel>
            <ComponentIndustrial>8</ComponentIndustrial>
        </costList>
        <Properties>
            <verbClass>CombatExtended.Verb_ShootCE</verbClass>
            <hasStandardCommand>true</hasStandardCommand>
            <defaultProjectile>Bullet_3006Springfield_FMJ</defaultProjectile>
            <burstShotCount>4</burstShotCount>
            <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
            <warmupTime>1.1</warmupTime>
            <range>34</range>
            <soundCast>Shot_GOW_MK1Lancer</soundCast>
            <soundCastTail>GunTail_Medium</soundCastTail>
            <muzzleFlashScale>9</muzzleFlashScale>
            <recoilAmount>1.65</recoilAmount>
        </Properties>
        <AmmoUser>
            <magazineSize>20</magazineSize>
            <reloadTime>3.5</reloadTime>
            <ammoSet>AmmoSet_3006Springfield</ammoSet>
        </AmmoUser>
        <FireModes>
            <aiUseBurstMode>true</aiUseBurstMode>
            <aiAimMode>AimedShot</aiAimMode>
            <aimedBurstShotCount>2</aimedBurstShotCount>
        </FireModes>
        <weaponTags>
            <li>CE_AI_AssaultWeapon</li>
            <li>CE_AI_Rifle</li>
            <li>IndustrialGunAdvanced</li>
        </weaponTags>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Gun_GOW_RetroLancer"]/tools</xpath>
        <value>
            <tools>
                <li Class="CombatExtended.ToolCE">
                    <label>stock</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>10</power>
                    <cooldownTime>1.8</cooldownTime>
                    <armorPenetrationBlunt>1.25</armorPenetrationBlunt>
                </li>

                <!-- Meleed Bayonet. -->
                <li Class="CombatExtended.ToolCE">
                    <label>long bayonet</label>
                    <capacities>
                        <li>Stab</li>
                        <li>Cut</li>
                    </capacities>
                    <power>19</power>
                    <cooldownTime>1.35</cooldownTime>
                    <armorPenetrationSharp>4.0</armorPenetrationSharp>
                    <chanceFactor>3.0</chanceFactor>
                    <soundMeleeHit>Shot_GOW_RetroLancerHit</soundMeleeHit>
                </li>
            </tools>
        </value>
    </Operation>

    <!-- ========================================================== -->
