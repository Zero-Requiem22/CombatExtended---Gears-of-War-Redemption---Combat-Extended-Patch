        </AmmoUser>
        <FireModes>
            <aiUseBurstMode>true</aiUseBurstMode>
            <aimedBurstShotCount>3</aimedBurstShotCount>
        </FireModes>
        <weaponTags>
            <li>CE_AI_AssaultWeapon</li>
            <li>CE_AI_Rifle</li>
            <li>IndustrialGunAdvanced</li>
        </weaponTags>
    </Operation>

    <!-- Chainsaw Melee -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Gun_GOW_MK2Lancer"]/tools</xpath>
        <value>
            <tools>
                <li Class="CombatExtended.ToolCE">
                    <label>chainsaw bayonet</label>
                    <capacities>
                        <li>Cut</li>
                    </capacities>
                    <power>25</power>
                    <cooldownTime>0.55</cooldownTime>
                    <armorPenetrationSharp>5</armorPenetrationSharp>
                    <chanceFactor>4.0</chanceFactor>
                    <soundMeleeHit>Shot_GOW_LancerHit</soundMeleeHit>
                    <soundMeleeMiss>Shot_GOW_LancerMiss</soundMeleeMiss>
                </li>
            </tools>
        </value>
    </Operation>

